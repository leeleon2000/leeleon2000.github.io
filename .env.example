# Cloudflare Web Analytics — JS beacon token.
# Get one from https://dash.cloudflare.com/?to=/:account/web-analytics
# When set, src/layouts/Layout.astro injects the beacon site-wide.
PUBLIC_CF_ANALYTICS_TOKEN=

# Optional: Google Search Console site verification.
# Get the meta-tag content value from https://search.google.com/search-console
PUBLIC_GOOGLE_SITE_VERIFICATION=
